# NaagRakshak Backend Configuration Template
ENVIRONMENT=development
PROJECT_NAME="NaagRakshak Backend API"
API_V1_STR=/api/v1
HOST=0.0.0.0
PORT=8000

# PostgreSQL Database / Neon Cloud Connection
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=naagrakshak
DATABASE_URL=postgresql+asyncpg://user:password@host.neon.tech/neondb?ssl=require

# AI / Search API Keys
OPENAI_API_KEY=your_openai_api_key
GEMINI_API_KEY=your_gemini_api_key
VERTEX_CREDENTIALS_PATH=keys/credentials.json
GOOGLE_SEARCH_API_KEY=your_google_search_api_key

# Sarvam AI Text-To-Speech (TTS) Key
SARVAM_API_KEY=your_sarvam_api_key
SARVAM_TTS_URL=https://api.sarvam.ai/text-to-speech

# Model Storage Paths
MODEL_ONNX_PATH=models/snake_model.onnx
CLASS_MAPPING_PATH=models/class_mapping.csv
SPECIES_DATA_PATH=models/indian_snakes.csv
